@model List<FoodProject.Data.Models.Subscribe>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:800px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h1 style="text-align:center; color:#333; margin-bottom:25px;">📧 Subscribe List</h1>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:center;">

            <thead>
                <tr style="background:#343a40; color:white;">
                    <th style="padding:10px;">Email</th>
                    <th style="padding:10px;">Delete</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr style="border-bottom:1px solid #ddd;">

                        <td style="padding:10px; color:#007bff;">@x.EMail</td>

                        <td>
                            <a href="/Newsletter/NewsletterDelete/@x.ID"
                               onclick="return confirm('Are you sure you want to delete this email?');"
                               style="background:#dc3545; color:white; padding:6px 12px;
                                          border-radius:8px; text-decoration:none;">
                                🗑 Delete
                            </a>
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('a[href*="NewsletterDelete"]').forEach(btn => {
            btn.addEventListener('click', function () {
                alert('Deleted successfully.');
            });
        });
    });
</script>