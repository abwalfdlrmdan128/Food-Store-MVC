@model List<FoodProject.Data.Models.Contact>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:1000px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h1 style="text-align:center; color:#333; margin-bottom:25px;">📩 Contact List</h1>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:center;">

            <thead>
                <tr style="background:#343a40; color:white;">
                    <th style="padding:10px;">Name</th>
                    <th style="padding:10px;">Surname</th>
                    <th style="padding:10px;">Email</th>
                    <th style="padding:10px;">Subject</th>
                    <th style="padding:10px;">Details</th>
                    <th style="padding:10px;">Delete</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr style="border-bottom:1px solid #ddd;">

                        <td style="padding:10px;">@x.ContactName</td>
                        <td style="padding:10px;">@x.ContactSurname</td>
                        <td style="padding:10px; color:#007bff;">@x.ContactEmail</td>
                        <td style="padding:10px;">@x.ContactSubject</td>

                        <!-- Details -->
                        <td>
                            <a href="/Contact/ContactDetails/@x.ContactID"
                               style="background:#17a2b8; color:white; padding:6px 12px;
                                          border-radius:8px; text-decoration:none;">
                                🔍 Details
                            </a>
                        </td>

                        <!-- Delete -->
                        <td>
                            <a href="/Contact/ContactDelete/@x.ContactID"
                               onclick="return confirm('Are you sure you want to delete this message?');"
                               style="background:#dc3545; color:white; padding:6px 12px;
                                          border-radius:8px; text-decoration:none;">
                                🗑 Delete
                            </a>
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>

</div>