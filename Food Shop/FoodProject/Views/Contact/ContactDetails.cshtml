@model FoodProject.Data.Models.Contact
@{
    ViewData["Title"] = "ContactDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:700px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h1 style="text-align:center; color:#333; margin-bottom:25px;">📩 Contact Details</h1>

    <div style="text-align:center;">

        <h3 style="color:#222;">
            @Model.ContactName @Model.ContactSurname
        </h3>

        <p style="color:#007bff; font-size:16px;">
            📧 @Model.ContactEmail
        </p>

        <div style="margin-top:20px; background:#f1f1f1; padding:15px; border-radius:10px;">
            <h4 style="color:#333;">@Model.ContactSubject</h4>
            <p style="color:#555;">@Model.ContactMessage</p>
        </div>

        <div style="margin-top:20px;">
            <a href="mailto:@Model.ContactEmail"
               style="background:#007bff; color:white; padding:10px 20px;
                      border-radius:8px; text-decoration:none; margin-right:10px;">
                📧 Send Mail
            </a>

            <a href="/Contact/ContactDelete/@Model.ContactID"
               onclick="return confirm('Are you sure you want to delete this message?');"
               style="background:#dc3545; color:white; padding:10px 20px;
                      border-radius:8px; text-decoration:none;">
                🗑 Delete
            </a>
        </div>

    </div>
</div>