@model List<FoodProject.Data.Models.Category>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:1000px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h2 style="text-align:center; margin-bottom:25px; color:#007bff;">📂 Category List</h2>

    <!-- Search -->
    @using (Html.BeginForm())
    {
        <div style="margin-bottom:20px; display:flex; justify-content:center;">
            <div style="display:flex; width:100%; max-width:400px;
                            box-shadow:0 5px 10px rgba(0,0,0,0.1); border-radius:10px; overflow:hidden;">

                @Html.TextBox("p", null, new {
                @class = "form-control",
                        placeholder = "Search category...",
                        style = "border:none; padding:10px;"
                        })

            <button type="submit"
                    style="background:#007bff; color:white; border:none; padding:10px 15px; cursor:pointer;">
                🔍
            </button>
        </div>
    </div>
        }

    <!-- Table -->
    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:center;">

            <thead>
                <tr style="background:#343a40; color:white;">
                    <th style="padding:10px;">Category Name</th>
                    <th style="padding:10px;">Status</th>
                    <th style="padding:10px;">Delete</th>
                    <th style="padding:10px;">Update</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr style="border-bottom:1px solid #ddd;">

                        <td style="padding:10px; font-weight:bold;">
                            @x.CategoryName
                        </td>

                        <td>
                            @if (x.Status)
                            {
                                <span style="background:#28a745; color:white; padding:5px 10px; border-radius:8px;">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span style="background:#6c757d; color:white; padding:5px 10px; border-radius:8px;">
                                    Inactive
                                </span>
                            }
                        </td>

                        <!-- Delete -->
                        <td>
                            <a href="/Category/CategoryDelete/@x.CategoryID"
                               onclick="return confirm('Are you sure you want to delete this item?');"
                               style="background:#dc3545; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                                🗑 Delete
                            </a>
                        </td>

                        <!-- Update -->
                        <td>
                            <a href="/Category/CategoryGet/@x.CategoryID"
                               onclick="return confirm('Are you sure you want to update this item?');"
                               style="background:#28a745; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                                ✏ Update
                            </a>
                        </td>

                    </tr>
                }
            </tbody>

        </table>
    </div>

    <!-- Add Button -->
    <div style="text-align:center; margin-top:25px;">
        <a href="/Category/CategoryAdd/"
           style="background:#007bff; color:white; padding:10px 20px;
                  border-radius:10px; text-decoration:none;
                  box-shadow:0 5px 10px rgba(0,0,0,0.2);">
            ➕ Add New Category
        </a>
    </div>

</div>