@model List<FoodProject.Data.Models.About>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:1000px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h2 style="text-align:center; color:#007bff; margin-bottom:25px;"> About List</h2>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; text-align:center;">

            <thead>
                <tr style="background:#343a40; color:white;">
                    <th style="padding:10px;">Title</th>
                    <th style="padding:10px;">Description</th>
                    <th style="padding:10px;">Image</th>
                    <th style="padding:10px;">Update</th>
                    <th style="padding:10px;">Delete</th>
                    <th style="padding:10px;">Details</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var x in Model)
                {
                    <tr style="border-bottom:1px solid #ddd;">

                        <td style="padding:10px; font-weight:bold;">
                            @x.AboutTitle
                        </td>

                        <td style="padding:10px; text-align:left; color:#555;">
                            @(string.IsNullOrEmpty(x.AboutText)
                                                    ? ""
                                                    : (x.AboutText.Length > 50
                                                    ? x.AboutText.Substring(0, 50) + "..."
                                                    : x.AboutText))
                    </td>

                        <td style="padding:10px;">
                            <img src="/Resimler/@x.AboutImageURL"
                                 style="max-width:180px; height:110px; object-fit:cover;
                                            border-radius:10px;
                                            box-shadow:0 5px 15px rgba(0,0,0,0.2);" />
                        </td>

                        <!-- Update -->
                        <td>
                            <a href="/About/AboutUpdate/@x.AboutID"
                               onclick="return confirm('Are you sure you want to update this item?');"
                               style="background:#28a745; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                                 Update
                            </a>
                        </td>

                        <!-- Delete -->
                        <td>
                            <a href="/About/AboutDelete/@x.AboutID"
                               onclick="return confirm('Are you sure you want to delete this item?');"
                               style="background:#dc3545; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                                 Delete
                            </a>
                        </td>

                        @* About Details *@
                        <td>
                            <a href="/About/AboutDetails/@x.AboutID"
                               style="background:#17a2b8; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                                 Details
                            </a>
                        </td>
                    </tr>
                                }
            </tbody>

        </table>
    </div>

    <div style="text-align:center; margin-top:25px;">
        <a href="/About/AboutAdd/"
           style="background:#007bff; color:white; padding:10px 20px;
                  border-radius:10px; text-decoration:none;
                  box-shadow:0 5px 10px rgba(0,0,0,0.2);">
             Add New About
        </a>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <script>
        alert("@TempData["Success"]");
    </script>
}