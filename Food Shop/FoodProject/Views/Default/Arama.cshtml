@model FoodProject.Data.AramaModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>FoodStore</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <script type="application/x-javascript">
        addEventListener("load", function () { setTimeout(hideURLbar, 0); }, false);
        function hideURLbar() { window.scrollTo(0, 1); }
    </script>

    <link rel="icon" type="image/png" href="~/Login/images/icons/e-commerce.png" />

    <link href="~/ETicaretTema/css/bootstrap.css" rel="stylesheet" />
    <link href="~/ETicaretTema/css/style.css" rel="stylesheet" />
    <link href="~/ETicaretTema/css/font-awesome.css" rel="stylesheet" />

    <script src="~/ETicaretTema/js/jquery-1.11.1.min.js"></script>

    <link href='//fonts.googleapis.com/css?family=Ubuntu:400,300,700' rel='stylesheet'>
    <link href='//fonts.googleapis.com/css?family=Open+Sans:400,600,800' rel='stylesheet'>

    <script src="~/ETicaretTema/js/move-top.js"></script>
    <script src="~/ETicaretTema/js/easing.js"></script>

</head>

<body>

    <!-- Header -->
    <div class="agileits_header">

        <!-- Search -->
        <div class="w3l_search">
            <form action="@Url.Action("Search", "Default")" method="get">
                <input type="text" name="p" value="Search a product..."
                       onfocus="this.value = '';"
                       onblur="if (this.value == '') {this.value = 'Search a product...';}"
                       required="">
                <input type="submit" value=" ">
            </form>
        </div>

        <!-- Cart -->
        <div class="product_list_header">
            <form action="#" method="post" class="last">
                <fieldset>
                    <input type="submit" value="Your Cart" class="button" />
                </fieldset>
            </form>
        </div>

        <!-- User -->
        <div class="w3l_header_right">
            <ul>
                <li class="dropdown profile_details_drop">
                    <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                        <i class="fa fa-user"></i><span class="caret"></span>
                    </a>
                    <div class="mega-dropdown-menu">
                        <ul class="dropdown-menu drp-mnu">
                            <li><a href="/Login/Index/">Login</a></li>
                            <li><a href="/Register/Index/">Register</a></li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>

        <!-- Contact -->
        <div class="w3l_header_right1">
            <h2><a href="/Default/Contact/">Contact Us</a></h2>
        </div>

        <div class="clearfix"></div>
    </div>

    <!-- Logo -->
    <div class="logo_products">
        <div class="container">

            <div class="w3ls_logo_products_left">
                <h1><a href="/Default/Index/"><span>Food</span> Store</a></h1>
            </div>

            <!-- Menu -->
            <div class="w3ls_logo_products_left1">
                <ul class="special_items">
                    <li><a href="/Default/Index/">Home</a><i>/</i></li>
                    <li><a href="/Default/About/">About</a><i>/</i></li>
                    <li><a href="/Default/Products/">Products</a></li>
                </ul>
            </div>

            <!-- Phone + Email -->
            <div class="w3ls_logo_products_left1">
                <ul class="phone_email">
                    <li><i class="fa fa-phone"></i>+(2011)06039247</li>
                    <li>
                        <i class="fa fa-envelope-o"></i>
                        <a href="mailto:abwalfdlrmdan128@gmail.com">
                            abwalfdlrmdan128@gmail.com
                        </a>
                    </li>
                </ul>
            </div>

            <div class="clearfix"></div>
        </div>
    </div>

    <!-- Sidebar Categories -->
    <div class="banner">
        <div class="w3l_banner_nav_left">
            <nav class="navbar nav_bottom">
                @await Component.InvokeAsync("CategoryGetList")
            </nav>
        </div>
    </div>

    <!-- Search Results -->
    <div class="container" style="background-color:#fff; margin-bottom:50px">

        <h2>Search Results</h2>
        <hr>

        <!-- About Results -->
        @foreach (var item in Model.Abouts)
        {
            <div>
                <a href="/Default/About/@item.AboutID">
                    @Html.Raw(item.AboutTitle)
                </a>
                <hr>
            </div>
        }

        <!-- Food Results -->
        @foreach (var item in Model.Foods)
        {
            <div>
                <a href="/Default/ProductDetails/@item.FoodID">
                    @Html.Raw(item.Name)
                </a>
                <hr>
            </div>
        }

    </div>

    <!-- Footer -->
    @await Html.PartialAsync("Footer")

    <!-- Scripts -->
    <script src="~/ETicaretTema/js/bootstrap.min.js"></script>

</body>
</html>