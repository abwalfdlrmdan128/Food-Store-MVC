@model FoodProject.Data.Models.Food
@{
    ViewData["Title"] = "ProductDetails";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="agileinfo_single">
    <h5>@Model.Name</h5>
    <div class="col-md-7 agileinfo_single_left">
        <img id="example" src="~/Resimler/@Model.ImageURL" alt="Product Image" class="img-responsive" />
    </div>
    <div class="col-md-5 agileinfo_single_right">
        <div class="rating1">
            <span class="starRating">
                <input id="rating5" type="radio" name="rating" value="5">
                <label for="rating5">5</label>
                <input id="rating4" type="radio" name="rating" value="4">
                <label for="rating4">4</label>
                <input id="rating3" type="radio" name="rating" value="3" checked>
                <label for="rating3">3</label>
                <input id="rating2" type="radio" name="rating" value="2">
                <label for="rating2">2</label>
                <input id="rating1" type="radio" name="rating" value="1">
                <label for="rating1">1</label>
            </span>
        </div>
        <div class="w3agile_description">
            <h4>About the Product:</h4>
            <p>
                @Model.Description
            </p>
        </div>
        <div class="snipcart-item block">
            <div class="snipcart-thumb agileinfo_single_right_snipcart">
                <h4>@Model.Price $<span>Stock count: @Model.Stock</span></h4>
            </div>
            <div class="snipcart-details agileinfo_single_right_details">
                <form>
                    <fieldset>
                        <a href="/Order/Index/@Model.FoodID" class="btn btn-danger" onclick="btnAdd()">Add to Cart</a>
                    </fieldset>
                </form>
            </div>
        </div>
    </div>
    <div class="clearfix"> </div>
</div>
<script>
    function btnAdd() {
        alert("Product successfully added to cart.")
    }
</script>