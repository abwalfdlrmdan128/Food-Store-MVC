@model IEnumerable<FoodProject.Data.Models.Food>

<h2 style="text-align:center;">Our Popular Products</h2>
<div class="agile_top_brands_grids">
    @foreach (var item in Model)
    {
        <div class="col-md-2 top_brand_left" style="margin-bottom:50px">
            <div class="hover14 column">
                <div class="agile_top_brand_left_grid">
                    <div class="agile_top_brand_left_grid1">
                        <figure>
                            <div class="snipcart-item block">
                                <div class="snipcart-thumb">
                                    <a href="/Default/ProductDetails/@item.FoodID">
                                        <img title=" " alt=" " style="width:400px; height:150px;" src="~/Resimler/@item.ImageURL" />
                                    </a>
                                    <p>@item.Name</p>
                                    <h4>@item.Price $</h4><h6>Stock: @item.Stock</h6>
                                </div>
                                <div class="snipcart-details top_brand_home_details">
                                    <form>
                                        <fieldset>
                                            <a href="/Order/Index/@item.FoodID" class="btn btn-danger" onclick="btnAdd()">Add to Cart</a>
                                        </fieldset>
                                    </form>
                                </div>
                            </div>
                        </figure>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="clearfix"> </div>
</div>
<script>
    function btnAdd()
    {
        alert("Product successfully added to cart.")
    }
</script>