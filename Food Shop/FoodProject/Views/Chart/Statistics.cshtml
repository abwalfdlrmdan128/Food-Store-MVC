@{
    ViewData["Title"] = "Statistics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="
    max-width: 1200px;
    margin: 30px auto;
    font-family: Arial, sans-serif;
">

    <h2 style="
        text-align:center;
        font-weight:bold;
        margin-bottom:25px;
        color:#2c3e50;">
         Dashboard Statistics
    </h2>

    <!-- ROW 1 -->
    <div style="display:flex; flex-wrap:wrap; gap:15px; justify-content:center;">

        <div style="flex:1; min-width:200px; background:#f39c12; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.userCount</h2>
            <p>User Count</p>
        </div>

        <div style="flex:1; min-width:200px; background:#2ecc71; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.categoriCount</h2>
            <p>Total Category</p>
        </div>

        <div style="flex:1; min-width:200px; background:#3498db; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.fCount</h2>
            <p>Total Food</p>
        </div>

        <div style="flex:1; min-width:200px; background:#9b59b6; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.ordercount</h2>
            <p>Order Count</p>
        </div>

    </div>

    <!-- ROW 2 -->
    <div style="display:flex; flex-wrap:wrap; gap:15px; justify-content:center; margin-top:20px;">

        <div style="flex:1; min-width:200px; background:#d35400; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.fSum</h2>
            <p>Sum Food</p>
        </div>

        <div style="flex:1; min-width:200px; background:#1abc9c; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.sebzeCount</h2>
            <p>Vegetable Count</p>
        </div>

        <div style="flex:1; min-width:200px; background:#c0392b; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.minfStock</h2>
            <p>Min Stock Food</p>
        </div>

        <div style="flex:1; min-width:200px; background:#7f8c8d; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.maxfStock</h2>
            <p>Max Stock Food</p>
        </div>

    </div>

    <!-- ROW 3 -->
    <div style="display:flex; flex-wrap:wrap; gap:15px; justify-content:center; margin-top:20px;">

        <div style="flex:1; min-width:200px; background:#01a3a4; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.foodPriceAvg $</h2>
            <p>Food Price Average</p>
        </div>

        <div style="flex:1; min-width:200px; background:#ffb142; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.toplamFruit</h2>
            <p>Sum Fruit</p>
        </div>

        <div style="flex:1; min-width:200px; background:#40407a; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.toplamVegetable</h2>
            <p>Sum Vegetable</p>
        </div>

        <div style="flex:1; min-width:200px; background:#4b4b4b; color:white;
            padding:20px; border-radius:15px; box-shadow:0 8px 18px rgba(0,0,0,0.12); text-align:center;">
            <h2>@ViewBag.maxFiyatFood</h2>
            <p>Max Price Food</p>
        </div>

    </div>

</div>