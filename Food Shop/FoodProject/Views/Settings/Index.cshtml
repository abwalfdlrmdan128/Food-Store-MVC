@model FoodProject.Data.UserUpdateModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Admin Information Update Page</h2>

<div class="card-body">
    <br />
    <form class="forms-sample" method="post">
        <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="namesurname" value="@Model.namesurname" class="form-control" />
        </div>
        <div class="form-group">
            <label>Username</label>
            <input type="text" name="username" value="@Model.username" class="form-control" />
        </div>
        <div class="form-group">
            <label>Email Address</label>
            <input type="text" name="email" value="@Model.email" class="form-control" />
        </div>
        <div class="form-group">
            <label>Change Password</label>
            <input type="password" name="password" value="" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/Chart/Statistics/" class="btn btn-light">Cancel</a>
    </form>
</div>