@model FoodProject.Data.Models.Food
@{
    ViewData["Title"] = "FoodDetails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input name="FoodID" value="@Model.FoodID" type="hidden" />

<div style="max-width:1000px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h1 style="text-align:center; color:#333; margin-bottom:30px;">🍽 Food Details</h1>

    <div style="display:flex; gap:30px; align-items:center; flex-wrap:wrap;">

        <!-- Image -->
        <div style="flex:1; text-align:center;">
            <img src="~/Resimler/@Model.ImageURL"
                 style="width:100%; max-width:450px; height:300px;
                        border-radius:15px;
                        box-shadow:0 10px 20px rgba(0,0,0,0.2);" />
        </div>

        <!-- Details -->
        <div style="flex:1;">
            <h2 style="color:#222;"><em>@Model.Name</em></h2>

            <h4 style="color:#555; margin-top:10px;">
                Category: <span style="color:#007bff;">@ViewBag.categoryName</span>
            </h4>

            <div style="margin-top:15px; display:flex; gap:20px;">
                <div style="background:#e8f5e9; padding:10px 15px; border-radius:10px;">
                    💰 Price: <b>$@Model.Price</b>
                </div>

                <div style="background:#fff3cd; padding:10px 15px; border-radius:10px;">
                    📦 Stock: <b>@Model.Stock</b>
                </div>
            </div>

            <div style="margin-top:20px; background:#f1f1f1; padding:15px; border-radius:10px;">
                <h4 style="margin-bottom:10px;">Description</h4>
                <p style="color:#555;">@Model.Description</p>
            </div>
        </div>

    </div>
</div>