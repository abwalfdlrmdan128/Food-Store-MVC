@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<FoodProject.Data.Models.Food>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:1000px; margin:40px auto; padding:25px;
            border:2px solid #e0e0e0; border-radius:15px;
            box-shadow:0 10px 25px rgba(0,0,0,0.1);
            background:linear-gradient(135deg,#ffffff,#f9f9f9);">

    <h1 style="text-align:center; color:#333; margin-bottom:20px;">🍽 Food List</h1>

    <table style="width:100%; border-collapse:collapse; text-align:center;">
        <tr style="background:#007bff; color:white;">
            <th style="padding:10px;">Food Name</th>
            <th style="padding:10px;">Price</th>
            <th style="padding:10px;">Stock</th>
            <th style="padding:10px;">Category</th>
            <th style="padding:10px;">Image</th>
            <th style="padding:10px;">Update</th>
            <th style="padding:10px;">Delete</th>
            <th style="padding:10px;">Details</th>
        </tr>

        @foreach (var x in Model)
        {
            <tr style="border-bottom:1px solid #ddd;">
                <td style="padding:10px;">@x.Name</td>
                <td style="padding:10px; color:#28a745;">$@x.Price</td>
                <td style="padding:10px;">@x.Stock</td>
                <td style="padding:10px;">@x.Category.CategoryName</td>

                <td style="padding:10px;">
                    <img src="~/Resimler/@x.ImageURL"
                         style="width:90px; height:70px; border-radius:10px; box-shadow:0 5px 10px rgba(0,0,0,0.2);" />
                </td>

                <td>
                    <a href="/Food/FoodUpdate/@x.FoodID"
                       style="background:#28a745; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                        ✏ Update
                    </a>
                </td>

                <td>
                    <a href="/Food/FoodDelete/@x.FoodID"
                       style="background:#dc3545; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                        🗑 Delete
                    </a>
                </td>

                <td>
                    <a href="/Food/FoodDetails/@x.FoodID"
                       style="background:#17a2b8; color:white; padding:6px 12px; border-radius:8px; text-decoration:none;">
                        🔍 Details
                    </a>
                </td>
            </tr>
        }
    </table>

    <div style="margin-top:20px; text-align:center;">
        @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }))
    </div>

    <div style="text-align:center; margin-top:20px;">
        <a href="/Food/FoodAdd/"
           style="background:green; color:white; padding:10px 20px; border-radius:10px; text-decoration:none;">
            ➕ New Food
        </a>
    </div>

</div>