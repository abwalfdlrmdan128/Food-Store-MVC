@{
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="container mt-5">

    <div class="checkout-card">

        <h3 class="text-center mb-4">Checkout</h3>

        <!-- Shipping -->
        <div class="section-box">

            <h5>Shipping Details</h5>

            <input id="mobile" class="form-control mb-2" placeholder=" Mobile Number" />
            <small class="text-danger" id="mobileError"></small>

            <input id="city" class="form-control mb-2" placeholder=" City" />
            <small class="text-danger" id="cityError"></small>

            <textarea id="address" class="form-control mb-2" placeholder=" Address"></textarea>
            <small class="text-danger" id="addressError"></small>

        </div>

        <!-- Payment -->
        <div class="section-box text-center">

            <h5>Payment Method</h5>

            <p class="text-muted">Secure payment powered by PayPal</p>

            <div id="paypal-button-container"></div>

        </div>

    </div>

</div>

<!-- PayPal -->
<script src="https://www.paypal.com/sdk/js?client-id=Ab2LP6jTdu-uderNfdUl39pz3sfY-x9XIP_pGGQdcRgV941LNBAtmJv_z93zYmsrGRyoLsWxK4p5vXkw"></script>

<script>

    function validateForm() {

        let isValid = true;

        const mobile = document.getElementById("mobile").value.trim();
        const city = document.getElementById("city").value.trim();
        const address = document.getElementById("address").value.trim();

        // reset errors
        document.getElementById("mobileError").innerText = "";
        document.getElementById("cityError").innerText = "";
        document.getElementById("addressError").innerText = "";

        if (mobile === "") {
            document.getElementById("mobileError").innerText = "Mobile is required";
            isValid = false;
        }

        if (city === "") {
            document.getElementById("cityError").innerText = "City is required";
            isValid = false;
        }

        if (address === "") {
            document.getElementById("addressError").innerText = "Address is required";
            isValid = false;
        }

        return isValid;
    }

    paypal.Buttons({

        onInit: function (data, actions) {

            actions.disable(); // البداية disabled

            // نراقب inputs
            document.querySelectorAll("input, textarea").forEach(el => {
                el.addEventListener("keyup", function () {
                    if (validateForm()) {
                        actions.enable();
                    } else {
                        actions.disable();
                    }
                });
            });
        },

        createOrder: function () {

            if (!validateForm()) {
                return;
            }

            const data = {
                mobile: document.getElementById("mobile").value,
                city: document.getElementById("city").value,
                address: document.getElementById("address").value
            };

            return fetch('/Order/CreatePaypalOrder', {
                method: 'post',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(res => res.id);
        },

        onApprove: function (data) {

            return fetch(`/Order/CapturePaypalOrder?orderId=${data.orderID}`, {
                method: 'post'
            })
            .then(() => {
                window.location.href = "/Order/UserOrders";
            });

        }

    }).render('#paypal-button-container');

</script>

<style>

    body {
        background: #f2f6fc;
    }

    .checkout-card {
        max-width: 600px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    .section-box {
        background: #fafafa;
        padding: 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        border: 1px solid #eee;
    }

    input, textarea {
        border-radius: 10px !important;
        padding: 10px;
    }

    .text-danger {
        font-size: 12px;
    }
</style>