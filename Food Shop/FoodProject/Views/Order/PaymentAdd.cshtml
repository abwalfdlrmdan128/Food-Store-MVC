@model FoodProject.Data.Models.Payment
@{
    ViewData["Title"] = "PaymentAdd";
    Layout = "~/Views/Shared/_SiteLayout.cshtml";
}

<div class="container" style="margin-bottom:20px; margin:auto; padding-right:150px;border:solid 2px ">
    <div style="position:center">
        <form action="PaymentAdd" controller="Order" method="post" class="creditly-card-form agileinfo_form">
            <section class="creditly-wrapper wthree, w3_agileits_wrapper">
                <div class="information-wrapper">
                    <div class="first-row form-group">
                        <div class="w3_agileits_card_number_grid_right">
                            @Html.ValidationMessageFor(x => x.MobileNumber, "", new { @style = "color:red" })
                            <div class="controls">
                                <label class="control-label">Phone Number: </label>
                                <input class="form-control" type="tel" name="MobileNumber" placeholder="Phone Number *">
                            </div>
                        </div>

                        <div class="w3_agileits_card_number_grids">
                            <div class="w3_agileits_card_number_grid_left">
                                @Html.ValidationMessageFor(x => x.Email, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">Email:</label>
                                    <input class="form-control" type="email" name="Email" placeholder="Email *">
                                </div>
                            </div>

                            <div class="w3_agileits_card_number_grid_right">
                                @Html.ValidationMessageFor(x => x.City, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">City: </label>
                                    <input class="form-control" type="text" name="City" placeholder="City *">
                                </div>
                            </div>

                            <div class="w3_agileits_card_number_grid_right">
                                @Html.ValidationMessageFor(x => x.Address, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">Address: </label>
                                    <input class="form-control" type="text" name="Address" placeholder="Address *">
                                </div>
                            </div>

                            @Html.ValidationMessageFor(x => x.NameSurname, "", new { @style = "color:red" })
                            <div class="controls">
                                <label class="control-label">Full Name: </label>
                                <input class="billing-address-name form-control" type="text" name="NameSurname" placeholder="Full Name *">
                            </div>

                            <div class="w3_agileits_card_number_grid_right">
                                @Html.ValidationMessageFor(x => x.CardNumber, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">Card Number: </label>
                                    <input class="form-control" type="text" name="CardNumber" placeholder="Card Number *">
                                </div>
                            </div>

                            <div class="w3_agileits_card_number_grid_right">
                                @Html.ValidationMessageFor(x => x.CardMonth_Year, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">Card Expiry (Month/Year): </label>
                                    <input class="form-control" type="text" name="CardMonth_Year" placeholder="MM/YY *">
                                </div>
                            </div>

                            <div class="w3_agileits_card_number_grid_right">
                                @Html.ValidationMessageFor(x => x.CardCVC, "", new { @style = "color:red" })
                                <div class="controls">
                                    <label class="control-label">CVV: </label>
                                    <input class="form-control" type="text" name="CardCVC" placeholder="CVV *">
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-danger" id="btnOk">Complete Order</button>

                    <br /><br /><br />
                </div>
            </section>
        </form>
    </div>
</div>

<script>
    try {
        const btn = document.querySelector('#btnOk');
        btn.addEventListener('click', () => {
            alert('Thank you for your order. Your order will be shipped as soon as possible.');
        })
    }
    catch(err)
    {
        alert("Error. Order could not be placed.");
    }
</script> 